{
  "info": {
    "name": "Claims API",
    "description": "Manual test collection for the Claims Processing case study. Run requests top-to-bottom within a folder \u2014 each folder captures a full scenario and chains the claim id via collection variables. Note: client/policy validation is performed by the Client Registry and Policy Manager mock adapters (verdict-returning, per the brief), not by the Claims API itself. Duplicate-claim handling has two separate mechanisms (folder 4): the Idempotency-Key request header resolves an accidental resend of the exact same submission to the same claim, while possibleDuplicateOfClaimId is a non-blocking flag for the analyst when another claim matches on policy + claim type + incident date \u2014 no database uniqueness constraint backs this, since a policy can have multiple legitimate claims.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "webhook_secret",
      "value": "dummy-shared-secret-change-me",
      "type": "string"
    },
    {
      "key": "claim_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "rejected_claim_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "declined_claim_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "webhook_event_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "webhook_signature",
      "value": "",
      "type": "string"
    },
    {
      "key": "idempotent_claim_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "duplicate_first_claim_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Health check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/actuator/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        }
      }
    },
    {
      "name": "1. Happy path (submit \u2192 approve \u2192 pay)",
      "item": [
        {
          "name": "1.1 Submit DEATH claim (HIGH priority)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('claim_id', body.id);",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('priority is HIGH', () => pm.expect(body.priority).to.eql('HIGH'));",
                  "pm.test('status is PENDING_ANALYST_APPROVAL', () => pm.expect(body.status).to.eql('PENDING_ANALYST_APPROVAL'));",
                  "pm.test('claimReference is human-readable (CLM-######)', () => pm.expect(body.claimReference).to.match(/^CLM-\\d{6,}$/));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"clientId\": \"CL-1001\", \"claimantFullName\": \"Registered Client CL-1001\", \"claimantIdNumber\": \"ID-CL-1001\", \"policyNumber\": \"POL-CL-1001\", \"claimType\": \"DEATH\", \"incidentDate\": \"2026-08-01\", \"claimedAmount\": 100000.0}"
            },
            "url": {
              "raw": "{{base_url}}/claims/submit",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "claims",
                "submit"
              ]
            }
          }
        },
        {
          "name": "1.2 Get claim by id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/claims/{{claim_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "claims",
                "{{claim_id}}"
              ]
            }
          }
        },
        {
          "name": "1.3 Get analyst queue (HIGH first)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/claims/queue",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "claims",
                "queue"
              ]
            }
          }
        },
        {
          "name": "1.4 Approve claim",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status is PAYMENT_REQUESTED', () => pm.expect(body.status).to.eql('PAYMENT_REQUESTED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"analystId\": \"analyst-1\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/claims/{{claim_id}}/approve",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "claims",
                "{{claim_id}}",
                "approve"
              ]
            }
          }
        },
        {
          "name": "1.5 Approve again (expect 409 - already actioned)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"analystId\": \"analyst-1\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/claims/{{claim_id}}/approve",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "claims",
                "{{claim_id}}",
                "approve"
              ]
            }
          }
        },
        {
          "name": "1.6 Payment webhook - SUCCESSFUL (signed)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const eventId = 'evt-' + Date.now();",
                  "const claimId = pm.collectionVariables.get('claim_id');",
                  "const outcome = 'SUCCESSFUL';",
                  "const secret = pm.collectionVariables.get('webhook_secret');",
                  "const payload = `${eventId}:${claimId}:${outcome}`;",
                  "const signature = CryptoJS.HmacSHA256(payload, secret).toString(CryptoJS.enc.Hex);",
                  "pm.collectionVariables.set('webhook_event_id', eventId);",
                  "pm.collectionVariables.set('webhook_signature', signature);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Payment-Signature",
                "value": "{{webhook_signature}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{webhook_event_id}}\",\n  \"claimId\": \"{{claim_id}}\",\n  \"outcome\": \"SUCCESSFUL\",\n  \"providerPaymentReference\": \"PROV-REF-9\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/claims/{{claim_id}}/payment-callback",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "claims",
                "{{claim_id}}",
                "payment-callback"
              ]
            }
          }
        },
        {
          "name": "1.7 Redeliver same webhook event (idempotent - still 200, no double-apply)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Payment-Signature",
                "value": "{{webhook_signature}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{webhook_event_id}}\",\n  \"claimId\": \"{{claim_id}}\",\n  \"outcome\": \"SUCCESSFUL\",\n  \"providerPaymentReference\": \"PROV-REF-9\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/claims/{{claim_id}}/payment-callback",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "claims",
                "{{claim_id}}",
                "payment-callback"
              ]
            }
          }
        },
        {
          "name": "1.8 Get claim - status PAID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('status is PAID', () => pm.expect(body.status).to.eql('PAID'));",
                  "pm.test('paymentReference set', () => pm.expect(body.paymentReference).to.eql('PROV-REF-9'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/claims/{{claim_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "claims",
                "{{claim_id}}"
              ]
            }
          }
        },
        {
          "name": "1.9 Get all claims (still finds it, unlike the queue)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "const paidClaim = body.find(c => c.id === pm.collectionVariables.get('claim_id'));",
                  "pm.test('paid claim is present in the full list', () => pm.expect(paidClaim).to.not.be.undefined);",
                  "pm.test('paid claim status is PAID', () => pm.expect(paidClaim.status).to.eql('PAID'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/claims",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "claims"
              ]
            }
          }
        }
      ]
    },
