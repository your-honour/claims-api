    {
      "name": "4. Idempotency & duplicate detection",
      "item": [
        {
          "name": "4.1 Submit claim with idempotency key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('idempotent_claim_id', body.id);",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "postman-demo-key-1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"clientId\": \"CL-6001\", \"claimantFullName\": \"Registered Client CL-6001\", \"claimantIdNumber\": \"ID-CL-6001\", \"policyNumber\": \"POL-CL-6001\", \"claimType\": \"MEDICAL\", \"incidentDate\": \"2026-08-01\", \"claimedAmount\": 500.0}"
